%% State initialization
q_pid  = q_d(1,:)';
dq_pid = zeros(3,1);
q_ctc  = q_d(1,:)';
dq_ctc = zeros(3,1);

I_err_pid  = zeros(3,1);
I_err_ctc  = zeros(3,1);
e_prev_pid = zeros(3,1);
de_pid_filt = zeros(3,1);
u_pid_cmd_state = zeros(3,1);
u_pid_motor_state = zeros(3,1);
motor_current_pid = zeros(3,1);
tau_pid_state = zeros(3,1);
tau_ctc_state = zeros(3,1);

q_pid_log      = zeros(n,3);
q_ctc_log      = zeros(n,3);
tau_ctc_log    = zeros(n,3);
tau_pid_eq_log = zeros(n,3);
pwm_pid_log    = zeros(n,3);
pwm_pid_cmd_log = zeros(n,3);
e_pid_log      = zeros(n,3);
e_ctc_log      = zeros(n,3);

theta_all     = zeros(n,3);
det_J_all     = zeros(n,1);
cond_J_all    = zeros(n,1);
singularity_flag = zeros(n,1);
near_sing_flag   = zeros(n,1);
v_mag            = zeros(n,1);
rpm_all          = zeros(n,3);
rpm_over_flag    = zeros(n,3);

q_pid_log(1,:) = q_pid';
q_ctc_log(1,:) = q_ctc';

%% Main simulation loop
fprintf('\n=== BAT DAU MO PHONG ===\n');

for k = 1:n
    xP  = x_traj(k);
    yP  = y_traj(k);
    phi = phi_traj(k);
    t_k = (k-1) * dt;

    P1 = [xP + m_plat*cos(phi + 210*pi/180), yP + m_plat*sin(phi + 210*pi/180)];
    P2 = [xP + m_plat*cos(phi + 330*pi/180), yP + m_plat*sin(phi + 330*pi/180)];
    P3 = [xP + m_plat*cos(phi +  90*pi/180), yP + m_plat*sin(phi +  90*pi/180)];
    P  = [P1; P2; P3];

    theta = zeros(1,3);
    J_kin = zeros(3,3);
    J_pos = zeros(3,2);
    ok = true;

    for i = 1:3
        dx = P(i,1) - A(i,1);
        dy = P(i,2) - A(i,2);
        d  = sqrt(dx^2 + dy^2);
        if d > 2*l || d < 0.01
            ok = false;
            break;
        end
        arg = min(max(d/(2*l), -1), 1);
        al  = atan2(dy, dx);
        be  = acos(arg);
        theta(i) = al - be;
        J_pos(i,:) = [A(i,1) + l*cos(theta(i)), A(i,2) + l*sin(theta(i))];
        J_kin(i,1) = -l*sin(theta(i));
        J_kin(i,2) =  l*cos(theta(i));
        J_kin(i,3) = -l*sin(theta(i))*(P(i,2)-yP) + l*cos(theta(i))*(P(i,1)-xP);
    end

    if ~ok
        continue;
    end

    theta_all(k,:) = theta;
    dJ = abs(det(J_kin));
    det_J_all(k) = dJ;
    cond_J_all(k) = ternval(dJ > 1e-10, cond(J_kin), Inf);
    if dJ < sing_thr
        singularity_flag(k) = 1;
    end
    if cond_J_all(k) > cond_thr
        near_sing_flag(k) = 1;
    end

    if k > 1 && k < n
        vx = (x_traj(k+1) - x_traj(k-1)) / (2*dt);
        vy = (y_traj(k+1) - y_traj(k-1)) / (2*dt);
    elseif k == 1
        vx = (x_traj(2) - x_traj(1)) / dt;
        vy = (y_traj(2) - y_traj(1)) / dt;
    else
        vx = (x_traj(end) - x_traj(end-1)) / dt;
        vy = (y_traj(end) - y_traj(end-1)) / dt;
    end
    v_mag(k) = sqrt(vx^2 + vy^2);

    if k > 1
        omega = (theta_all(k,:) - theta_all(k-1,:)) / dt;
        rpm_all(k,:) = abs(omega) * 60 / (2*pi);
        rpm_over_flag(k,:) = rpm_all(k,:) > rpm_max_adj;
    end

    if k > 1
        q_ref   = q_d(k,:)';
        dq_ref  = dq_d(k,:)';
        ddq_ref = ddq_d(k,:)';

        q_ref_prev = q_d(k-1,:)';
        n_inner = max(1, ceil(dt / sim_ctrl_dt));
        h_inner = dt / n_inner;
        u_pid_cmd = u_pid_cmd_state;

        for jj = 1:n_inner
            blend = jj / n_inner;
            % q_ref_i: goc encoder muc tieu noi suy (rad)
            % Giong ESP32: target_chuyen_pulse tang dan tu vi tri hien tai den dich
            q_ref_i = q_ref_prev + blend * (q_ref - q_ref_prev);

            % Chuyen sang xung (giong bien "target_chuyen_pulse" trong ESP32)
            target_chuyen_pulse = q_ref_i * scale;

            % Goc encoder do duoc (lam tron xuong xung nguyen, giong round() cua ESP32)
            q_meas_pid_pulse = round(q_pid * scale);

            % Sai so xung: dung target_chuyen_pulse tu diem tham chieu (KHONG blend tu q_meas)
            % Day la diem sua so voi phien ban cu
            e_pid_pulse = target_chuyen_pulse - q_meas_pid_pulse;
            I_err_pid = I_err_pid + e_pid_pulse * h_inner;
            I_err_pid = max(min(I_err_pid, Imax_pid), -Imax_pid);

            de_pid_raw = (e_pid_pulse - e_prev_pid) / h_inner;
            de_pid_filt = deriv_filter * de_pid_raw + (1-deriv_filter) * de_pid_filt;
            e_prev_pid = e_pid_pulse;

            u_pid_cmd = kp_pid*e_pid_pulse + ki_pid*I_err_pid + kd_pid*de_pid_filt;
            u_pid_cmd = max(min(u_pid_cmd, PWM_MAX), -PWM_MAX);
            u_deadband = sign(u_pid_cmd) .* max(abs(u_pid_cmd) - PWM_DEADBAND, 0);
            u_deadband = u_deadband * PWM_MAX / (PWM_MAX - PWM_DEADBAND);
            u_pid_motor_state = u_deadband;
            u_pid_motor_state = max(min(u_pid_motor_state, PWM_MAX), -PWM_MAX);

            v_pid = motor_efficiency * (u_pid_motor_state / PWM_RESOLUTION_MAX) * V_supply;
            motor_current_pid = motor_current_pid + (h_inner / L_motor) * ...
                (v_pid - R_motor*motor_current_pid - Ke_motor*dq_pid);
            motor_current_pid = max(min(motor_current_pid, I_stall), -I_stall);
            tau_pid_state = Kt_motor * motor_current_pid;
            tau_pid_state = max(min(tau_pid_state, tau_max), -tau_max);

            friction_p = tau_friction*sign(dq_pid) + B_viscous*dq_pid;
            M_k = calc_M(q_pid);
            G_k = calc_G(q_pid);
            ddq_pid = M_k \ (tau_pid_state - G_k - friction_p);
            dq_pid = dq_pid + ddq_pid * h_inner;
            q_pid  = q_pid  + dq_pid  * h_inner;

            q_meas_ctc = q_ctc + 0.15*sigma_encoder*randn(3,1);
            e_ctc = q_ref_i - q_meas_ctc;
            I_err_ctc = I_err_ctc + e_ctc * h_inner;
            I_err_ctc = max(min(I_err_ctc, 0.4), -0.4);
            de_ctc = dq_ref - dq_ctc;
            a_des = ddq_ref + Kd_ctc*de_ctc + Kp_ctc*e_ctc + Ki_ctc*I_err_ctc;

            M_c = calc_M(q_ctc);
            C_c = calc_C(q_ctc, dq_ctc);
            G_c = calc_G(q_ctc);
            tau_ctc_cmd = M_c*a_des + C_c*dq_ctc + G_c;
            tau_ctc_cmd = max(min(tau_ctc_cmd, tau_max), -tau_max);
            tau_ctc_state = tau_ctc_state + (h_inner/motor_tau) * (tau_ctc_cmd - tau_ctc_state);

            friction_c = tau_friction*sign(dq_ctc) + B_viscous*dq_ctc;
            ddq_ctc = M_c \ (tau_ctc_state - C_c*dq_ctc - G_c - friction_c);
            dq_ctc = dq_ctc + ddq_ctc * h_inner;
            q_ctc  = q_ctc  + dq_ctc  * h_inner;
        end

        u_pid_cmd_state = u_pid_cmd;
        u_pid = u_pid_motor_state;
        tau_pid_eq = tau_pid_state;
        tau_ctc = tau_ctc_state;

        q_pid_log(k,:)      = q_pid';
        q_ctc_log(k,:)      = q_ctc';
        tau_ctc_log(k,:)    = tau_ctc';
        tau_pid_eq_log(k,:) = tau_pid_eq';
        pwm_pid_log(k,:)    = u_pid';
        pwm_pid_cmd_log(k,:) = u_pid_cmd_state';
        e_pid_log(k,:)      = (q_ref - q_pid)';
        e_ctc_log(k,:)      = e_ctc';
    end

    % 2D update
    for i = 1:3
        set(h_link2d(i),'XData',[A(i,1) J_pos(i,1) P(i,1)], ...
                        'YData',[A(i,2) J_pos(i,2) P(i,2)]);
    end
    set(pt_plat2d,'XData',[P1(1) P2(1) P3(1)], 'YData',[P1(2) P2(2) P3(2)]);
    set(pt_G2d,'XData',xP,'YData',yP);

    % 3D update
    za = 0;
    for i = 1:3
        Ex = J_pos(i,1);  Ey = J_pos(i,2);
        Px_i = P(i,1);    Py_i = P(i,2);

        ptA  = [A(i,1), A(i,2), za];
        ptE  = [Ex, Ey, za];
        ptPi = [Px_i, Py_i, za];

        [cx_t,cy_t,cz_t] = arm_body_surf(ptA, ptE, hw, ht);
        set(h3d_links(i,1),'XData',cx_t,'YData',cy_t,'ZData',cz_t);
        [cx_t,cy_t,cz_t] = arm_cap_arc(ptA, ptE, -1, hw, ht, n_cap);
        set(h3d_caps1(i,1),'XData',cx_t,'YData',cy_t,'ZData',cz_t);
        [cx_t,cy_t,cz_t] = arm_cap_arc(ptA, ptE, +1, hw, ht, n_cap);
        set(h3d_caps2(i,1),'XData',cx_t,'YData',cy_t,'ZData',cz_t);

        [cx_t,cy_t,cz_t] = arm_body_surf(ptE, ptPi, hw, ht);
        set(h3d_links(i,2),'XData',cx_t,'YData',cy_t,'ZData',cz_t);
        [cx_t,cy_t,cz_t] = arm_cap_arc(ptE, ptPi, -1, hw, ht, n_cap);
        set(h3d_caps1(i,2),'XData',cx_t,'YData',cy_t,'ZData',cz_t);
        [cx_t,cy_t,cz_t] = arm_cap_arc(ptE, ptPi, +1, hw, ht, n_cap);
        set(h3d_caps2(i,2),'XData',cx_t,'YData',cy_t,'ZData',cz_t);

        [sx2,sy2,sz2] = sphere(12);
        set(h3d_joints(i,1),'XData',sx2*jr+Ex,   'YData',sy2*jr+Ey,   'ZData',sz2*jr+za);
        set(h3d_joints(i,2),'XData',sx2*jr+Px_i, 'YData',sy2*jr+Py_i, 'ZData',sz2*jr+za);
    end
    set(h3d_plat,'XData',[P1(1) P2(1) P3(1)], 'YData',[P1(2) P2(2) P3(2)], 'ZData',[za za za]);
    set(h3d_ctr,'XData',xP,'YData',yP,'ZData',za);

    % sin/cos markers
    for i = 1:3
        h_sin_pt(i).XData = t_k;
        h_sin_pt(i).YData = sin(theta(i));
        h_cos_pt(i).XData = t_k;
        h_cos_pt(i).YData = cos(theta(i));
    end

    % Right panels
    if k > 1
        for i = 1:3
            ln_r(1,i).XData = [ln_r(1,i).XData, t_k];
            ln_r(1,i).YData = [ln_r(1,i).YData, tau_ctc_log(k,i)*1000];
            pt_r(1,i).XData = t_k;
            pt_r(1,i).YData = tau_ctc_log(k,i)*1000;
            ln_tau_pid(i).XData = [ln_tau_pid(i).XData, t_k];
            ln_tau_pid(i).YData = [ln_tau_pid(i).YData, tau_pid_eq_log(k,i)*1000];
            pt_tau_pid(i).XData = t_k;
            pt_tau_pid(i).YData = tau_pid_eq_log(k,i)*1000;

            ln_r(2,i).XData = [ln_r(2,i).XData, t_k];
            ln_r(2,i).YData = [ln_r(2,i).YData, pwm_pid_log(k,i)];
            pt_r(2,i).XData = t_k;
            pt_r(2,i).YData = pwm_pid_log(k,i);
            ln_pwm_cmd(i).XData = [ln_pwm_cmd(i).XData, t_k];
            ln_pwm_cmd(i).YData = [ln_pwm_cmd(i).YData, pwm_pid_cmd_log(k,i)];
            pt_pwm_cmd(i).XData = t_k;
            pt_pwm_cmd(i).YData = pwm_pid_cmd_log(k,i);

            ln_r(3,i).XData = [ln_r(3,i).XData, t_k];
            ln_r(3,i).YData = [ln_r(3,i).YData, rad2deg(e_ctc_log(k,i))];
            pt_r(3,i).XData = t_k;
            pt_r(3,i).YData = rad2deg(e_ctc_log(k,i));

            ln_r(4,i).XData = [ln_r(4,i).XData, t_k];
            ln_r(4,i).YData = [ln_r(4,i).YData, rad2deg(e_pid_log(k,i))];
            pt_r(4,i).XData = t_k;
            pt_r(4,i).YData = rad2deg(e_pid_log(k,i));
        end
    end

    % Goc hien thi: theta_all la goc hinh hoc (tinh o vong lap chinh)
    % Goc encoder tuong ung: theta_all - offset_deg
    theta_enc_deg = rad2deg(theta) - offset_deg';  % goc encoder (do)
    ss = 'OK - An toan'; sc = [0 0.55 0];
    if singularity_flag(k), ss = 'CANH BAO KY DI';     sc = [0.85 0 0];   end
