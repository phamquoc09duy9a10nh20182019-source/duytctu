function Robot3RRR_DayDu_Realistic(traj_choice, v_des, varargin)
clc; close all;
rng(42);

%% Geometry
H = 50;
l = 20;

platform_side = H / 10;
r_plat = platform_side / sqrt(3);
m_plat = r_plat;

Lm = l / 100;
rm = r_plat / 100;

A1 = [0, 0];
A2 = [H, 0];
A3 = [H/2, (sqrt(3)/2)*H];
A  = [A1; A2; A3];
Am = A / 100;

OFFSET_plat = [210; 330; 90] * pi/180;

% =========================================================
% OFFSET CALIBRATION - lay truc tiep tu RRResp.ino
% Cong thuc ESP32:
%   target_goc_i (do) = theta_hinh_hoc (do) - offset_i
%   pulse_i           = (target_goc_i / 360) * CPR
% Nguoc lai (encoder -> hinh hoc):
%   theta_hinh_hoc (do) = goc_encoder (do) + offset_i
% =========================================================
offset_deg = [-19.49; 100.51; -139.49];  % do, khop 1,2,3 (tu RRResp.ino)
offset_rad = offset_deg * pi / 180;      % rad

%% Physical parameters
KL      = 100;
m_seg   = 100;
w_arm   = 4;
t_arm   = 0.5;
tau_max = 0.6;
CPR     = 8192;

% =========================================================
% THONG SO MOTOR - Tinh truc tiep tu datasheet
% Model : GA32Y-31ZY-1280 | Reduction 71:1 | 12V | 112 RPM
% No-load : 112 RPM, 0.45 A
% Rated  : 90 RPM, 1.8 A, 10 kg.cm
% Stall  : 33 kg.cm, 5 A
% =========================================================
V_supply     = 12;           % V
I_stall      = 5.0;          % A  (stall current)
ratio_gear   = 71;           % ti so giam toc

% Dien tro: R = V / I_stall (omega=0)
R_motor      = V_supply / I_stall;          % = 2.4 ohm

% Ke (back-EMF): tinh tren motor shaft (truoc gearbox)
% omega_noload_motor = 112 RPM * 71 = 7952 RPM
omega_noload_rpm = 112 * ratio_gear;
omega_no_load    = omega_noload_rpm * 2*pi / 60;  % rad/s, motor shaft
I_noload         = 0.45;                           % A
Ke_motor = (V_supply - I_noload * R_motor) / omega_no_load;  % V.s/rad

% Kt: tinh tren motor shaft
% T_stall_output = 33 kg.cm = 3.237 N.m
% Hieu suat gearbox planetary ~75%
eta_gear     = 0.75;
T_stall_out  = 33 * 0.0981;                        % N.m (output shaft)
T_stall_mot  = T_stall_out / (ratio_gear * eta_gear); % N.m (motor shaft)
Kt_motor     = T_stall_mot / I_stall;               % N.m/A

% J_motor: uoc tinh cho motor DC 32mm (khong co trong datasheet)
% Gia tri pho bien: J_rotor~1.5e-6, J_gear~0.3*J_rotor
J_motor_total = 1.95e-6;    % kg.m^2

% b_motor (viscous damping): tu no-load friction
tau_noload_mot = Ke_motor * I_noload;  % moment can ~ Ke*I_noload
b_motor        = tau_noload_mot / omega_no_load;  % N.m.s/rad

% L_motor: uoc tinh tau_elec = L/R ~ 2ms
L_motor = 0.002 * R_motor;  % H

% Hieu suat toan bo (motor + gearbox) tai rated load
% P_out = 10 kg.cm * 90 RPM = 9.246 W
% P_in  = 12V * 1.8A = 21.6 W
motor_efficiency = (10*0.0981 * 90*2*pi/60) / (V_supply * 1.8);  % = 0.428

tau_stall_motor = Kt_motor * I_stall;
motor_tau       = J_motor_total * R_motor / (Kt_motor * Ke_motor);

m_link_kg = m_seg / 1000;

I_link  = (1/3) * m_link_kg * Lm^2;
I_bi    = (1/3) * (m_link_kg*0.5) * Lm^2;
I_total = I_link + I_bi;

tau_friction   = 0.005;
B_viscous      = b_motor;
sigma_encoder  = 1 * (2*pi / CPR);
rpm_max_adj    = 112 * sqrt(100/KL);  % RPM output shaft, hieu chinh theo tai

% =========================================================
% DONG LUC HOC BAC 2 DAY DU cho robot 3-RRR phang nam ngang
%
% Mo hinh moi khop i (2 khau + phan platform):
%   Khau 1 (proximal): khoi luong m1 = m_link_kg, dai Lm
%                      qua tinh doi voi khop: I1 = (1/3)*m1*Lm^2
%                      tam khoi luong: Lc1 = Lm/2
%   Khau 2 (distal):   khoi luong m2 = m_link_kg, dai Lm
%                      qua tinh doi voi khop: I2 = (1/3)*m2*Lm^2
%                      tam khoi luong: Lc2 = Lm/2
%   Platform (phan 1/3 moi khop chiu): mp = m_plat_kg/3
%                      coi la diem khoi luong tai dau khau 2
%   Motor:             J_motor_total them vao duong cheo M
%
% Robot nam ngang -> G(q) = 0
%
% Phuong trinh: M(q)*ddq + C(q,dq)*dq = tau - friction
%
% q = [q1; q2; q3]  goc khop 1, 2, 3 (rad)
% dq= [dq1;dq2;dq3] van toc goc (rad/s)
% =========================================================

m1      = m_link_kg;           % kg, khau proximal
m2      = m_link_kg;           % kg, khau distal
mp_each = (KL/1000) / 3;       % kg, phan platform moi khop chiu
Lc      = Lm / 2;              % m, vi tri tam khoi luong moi khau
I1_cm   = (1/12)*m1*Lm^2;     % qua tinh doi voi tam (Steiner sau)
I2_cm   = (1/12)*m2*Lm^2;

% Ham tinh ma tran M(q) - 3x3 duong cheo (robot song song: khop doc lap)
% Voi robot 3-RRR song song phang, moi chuoi dong hoc RR doc lap nhau
% => M la ma tran duong cheo, phan tu thu i:
%   M_ii = I1 + m1*Lc^2                    (khau 1 quay quanh Ai)
%        + I2 + (m2+mp_each)*(Lm^2)        (khau 2 quay quanh dau khau 1, arm = Lm)
%        + (m2+mp_each)*Lm^2               (khoang cach tu Ai den diem B qua theta_i)
%        + J_motor_total                   (motor phan hoi)
%
% Chinh xac hon: qua tinh toan bo cua chuoi i doi voi khop i:
%   M_ii(q_i) = [I1_cm + m1*Lc^2]
%             + [I2_cm + (m2+mp_each)*Lc^2 + m1*Lm^2 + 2*m1*Lm*Lc*cos(q2_i)] (neu 2 bac tu do)
% Nhung vi moi chuoi RR chi co 1 bac tu do (khop i), khau 2 bi rang buoc:
% => goc khau 2 phu thuoc q_i qua IK, ddq2 = ddq_i (cung dong truc)
%
% Dang gon nhat cho 3-RRR doc lap (moi khop i):
%   M_ii = J_eff(q_i)
%        = I1_cm + m1*Lc^2
%        + I2_cm + (m2+mp_each)*(Lm^2 + Lc^2 + 2*Lm*Lc*cos(q_elbow_i))
%        + J_motor_total
% Vi khong co thong tin q_elbow (goc khau 2 trong chuoi RR), va robot song song
% co rang buoc vi tri nen qua tinh hieu dung phu thuoc cau hinh.
% Su dung xap xi pho bien cho 3-RRR nho (l ngan, phan phoi deu):
%   J_eff_i = (1/3)*m1*Lm^2 + (m2+mp_each)*Lm^2 + J_motor_total
%           (tuong duong 2 khau thang hang, worst case qua tinh lon nhat)

J_eff_const = (1/3)*m1*Lm^2 + (m2 + mp_each)*Lm^2 + J_motor_total;

% Ham M(q): phu thuoc q de tinh J_eff chinh xac hon qua goc khau
% Dung cong thuc Lagrange day du cho chuoi RR:
%   q1i = theta_i (goc khop i)
%   q2i = goc khau 2 trong chuoi i (tinh tu IK)
%   J_eff_i = m1*Lc^2 + I1_cm
%           + (m2+mp_each)*(Lm^2 + Lc^2 + 2*Lm*Lc*cos(q2i)) + I2_cm
%           + J_motor_total
% q2i duoc xap xi tu goc khop hien tai: khong co trong q, dung gia tri trung binh
% => de don gian va on dinh, dung J_eff_const (xap xi bao quanh)

calc_G = @(q) zeros(3,1);   % nam ngang, G = 0

calc_M = @(q) diag([ ...
    J_eff_const + (m2+mp_each)*Lm^2*(1 + 0.5*cos(q(1))), ...
    J_eff_const + (m2+mp_each)*Lm^2*(1 + 0.5*cos(q(2))), ...
    J_eff_const + (m2+mp_each)*Lm^2*(1 + 0.5*cos(q(3)))  ...
]);

% Ham C(q,dq): he so Coriolis/ly tam
% Voi he 1 bac tu do moi khop, C(q,dq)*dq = c_i(q,dq)*dq_i
% c_i = dM_ii/dq_i * dq_i / 2  (phuong trinh Lagrange)
%      = -(m2+mp_each)*Lm^2 * 0.5*sin(q_i) * dq_i / 2
%      = -0.25*(m2+mp_each)*Lm^2 * sin(q_i) * dq_i
% => C la ma tran duong cheo:
%   C_ii = -0.25*(m2+mp_each)*Lm^2 * sin(q_i) * dq_i

calc_C = @(q, dq) diag([ ...
    -0.25*(m2+mp_each)*Lm^2 * sin(q(1)) * dq(1), ...
    -0.25*(m2+mp_each)*Lm^2 * sin(q(2)) * dq(2), ...
    -0.25*(m2+mp_each)*Lm^2 * sin(q(3)) * dq(3)  ...
]);

fprintf('=== DONG LUC HOC BAC 2 (3-RRR, nam ngang) ===\n');
fprintf('m1=%.4f kg | m2=%.4f kg | mp_each=%.4f kg\n', m1, m2, mp_each);
fprintf('Lm=%.4f m | Lc=%.4f m\n', Lm, Lc);
fprintf('J_eff_const=%.6f kg.m^2\n', J_eff_const);
fprintf('G(q) = 0 (nam ngang)\n');

fprintf('=== THONG SO ROBOT 3-RRR ===\n');
fprintf('L=%g cm | H=%g cm | tau_max=%.2f N.m | CPR=%d\n', l, H, tau_max, CPR);
fprintf('I_link=%.6f kg.m^2 | I_total=%.6f kg.m^2\n', I_link, I_total);
fprintf('tau_friction=%.4f N.m | B_viscous=%.4f N.m.s/rad\n', tau_friction, B_viscous);
fprintf('Offset calibration (tu RRResp.ino):\n');
fprintf('  offset_1=%.2f deg | offset_2=%.2f deg | offset_3=%.2f deg\n', ...
    offset_deg(1), offset_deg(2), offset_deg(3));
fprintf('sigma_encoder=%.5f rad (%.4f deg)\n', sigma_encoder, rad2deg(sigma_encoder));
fprintf('Motor: R=%.2f ohm | L=%.3f H | Kt=%.3f | Ke=%.3f | J=%.5f | b=%.5f\n', ...
    R_motor, L_motor, Kt_motor, Ke_motor, J_motor_total, b_motor);
fprintf('Motor: tau_stall=%.3f N.m | omega_no_load=%.2f rad/s | tau_m=%.4f s\n', ...
    tau_stall_motor, omega_no_load, motor_tau);
fprintf('Motor: he so hieu dung truyen dong/tai = %.3f\n', motor_efficiency);

%% Controller parameters
PWM_MAX = 100;
PWM_RESOLUTION_MAX = 255;

kp_pid = 3.5;
ki_pid = 0.2;
kd_pid = 0.035;

scale = CPR / (2*pi);
sim_ctrl_dt = 0.002;
deriv_filter = 0.18;
Imax_pid = 120;
PWM_DEADBAND = 6;

alpha  = 15;
beta   = 10;
Kp_ctc = (alpha^2 + beta^2) * eye(3);
Kd_ctc = 2 * alpha * eye(3);
Ki_ctc = 5 * eye(3);

fprintf('\n=== BO DIEU KHIEN ===\n');
fprintf('PID ESP32: Kp=%.3f | Ki=%.3f | Kd=%.3f (PWM/xung)\n', kp_pid, ki_pid, kd_pid);
fprintf('PWM ESP32: lenh max=%d tren thang 8-bit %d => duty max=%.1f%%\n', ...
    PWM_MAX, PWM_RESOLUTION_MAX, 100*PWM_MAX/PWM_RESOLUTION_MAX);
fprintf('CTC: alpha=%d | beta=%d | Kp=%.0f | Kd=%.0f | Ki=%.0f\n', ...
    alpha, beta, Kp_ctc(1,1), Kd_ctc(1,1), Ki_ctc(1,1));

%% Trajectory selection
fprintf('\n1=Duong thang  2=Tam giac  3=Hinh vuong  4=Duong tron\n');
if nargin < 1 || isempty(traj_choice)
    traj_choice = input('Chon quy dao (1-4): ');
end
if nargin < 2 || isempty(v_des)
    v_des = input('Van toc (cm/s): ');
end

x0_cm = H/2;
y0_cm = (sqrt(3)/4)*H;
n     = 200;

switch traj_choice
    case 1
        if numel(varargin) >= 2
            xt = varargin{1};
            yt = varargin{2};
        else
            xt = input('X dich (cm): ');
            yt = input('Y dich (cm): ');
        end
        dist   = sqrt((xt-x0_cm)^2 + (yt-y0_cm)^2);
        T_sim  = dist / v_des;
        x_traj = linspace(x0_cm, xt, n);
        y_traj = linspace(y0_cm, yt, n);

    case 2
        if numel(varargin) >= 1
            sl = varargin{1};
        else
            sl = input('Canh tam giac (cm): ');
        end
        ang = [90, 210, 330] * pi/180;
        r_tri = sl / sqrt(3);
        nps = floor(n/3);
        x_traj = [];
        y_traj = [];
        for i = 1:3
            ni = mod(i,3) + 1;
            x_traj = [x_traj, linspace(x0_cm + r_tri*cos(ang(i)), x0_cm + r_tri*cos(ang(ni)), nps)]; %#ok
            y_traj = [y_traj, linspace(y0_cm + r_tri*sin(ang(i)), y0_cm + r_tri*sin(ang(ni)), nps)]; %#ok
        end
        n = length(x_traj);
        dist  = 3 * sl;
        T_sim = dist / v_des;

    case 3
        if numel(varargin) >= 1
            sl = varargin{1};
        else
            sl = input('Canh hinh vuong (cm): ');
        end
        hs = sl / 2;
        corn = [x0_cm-hs, y0_cm-hs;
                x0_cm+hs, y0_cm-hs;
                x0_cm+hs, y0_cm+hs;
                x0_cm-hs, y0_cm+hs];
        nps = floor(n/4);
        x_traj = [];
        y_traj = [];
        for i = 1:4
            ni = mod(i,4) + 1;
            x_traj = [x_traj, linspace(corn(i,1), corn(ni,1), nps)]; %#ok
            y_traj = [y_traj, linspace(corn(i,2), corn(ni,2), nps)]; %#ok
        end
        n = length(x_traj);
        dist  = 4 * sl;
        T_sim = dist / v_des;

    case 4
        if numel(varargin) >= 1
            rc = varargin{1};
        else
            rc = input('Ban kinh (cm): ');
        end
        thc = linspace(0, 2*pi, n);
        x_traj = x0_cm + rc*cos(thc);
        y_traj = y0_cm + rc*sin(thc);
        dist  = 2*pi*rc;
        T_sim = dist / v_des;

    otherwise
        error('Lua chon khong hop le');
end

phi_traj   = zeros(1, n);
T_vec      = linspace(0, T_sim, n);
dt         = T_sim / (n-1);
traj_names = {'Duong thang','Tam giac','Hinh vuong','Duong tron'};

fprintf('Quy dao: %s | L=%.2f cm | T=%.2f s | n=%d\n', ...
    traj_names{traj_choice}, dist, T_sim, n);

%% Inverse kinematics
% q_geo(k,i) : goc hinh hoc (rad) - goc that cua khau trong khong gian
% q_d(k,i)   : goc ENCODER (rad)  - goc ma ESP32 do duoc = q_geo - offset_rad
%              Day la gia tri PID dung de so sanh voi encoder thuc
x_m = x_traj / 100;
y_m = y_traj / 100;

q_geo = zeros(n, 3);   % goc hinh hoc (rad)
q_d   = zeros(n, 3);   % goc encoder  (rad) = q_geo - offset_rad

for k = 1:n
    xP = x_m(k);
    yP = y_m(k);
    for i = 1:3
        Ppx = xP + rm*cos(OFFSET_plat(i));
        Ppy = yP + rm*sin(OFFSET_plat(i));
        dx  = Ppx - Am(i,1);
        dy  = Ppy - Am(i,2);
        d   = sqrt(dx^2 + dy^2);
        if d <= 2*Lm && d > 1e-4
            arg = min(max(d/(2*Lm), -1), 1);
            q_geo(k,i) = atan2(dy, dx) - acos(arg);
        elseif k > 1
            q_geo(k,i) = q_geo(k-1,i);
        end
        % Chuyen sang goc encoder (giong ESP32):
        %   target_goc_deg = q_geo_deg - offset_deg
        %   <=> q_enc_rad  = q_geo_rad - offset_rad
        q_d(k,i) = q_geo(k,i) - offset_rad(i);
    end
end

dq_d  = zeros(n, 3);
ddq_d = zeros(n, 3);
for i = 1:3
    dq_d(:,i)  = gradient(q_d(:,i), dt);
    ddq_d(:,i) = gradient(dq_d(:,i), dt);
end

%% Singularity map
fprintf('Dang tinh ban do ky di...\n');
[X_grid, Y_grid] = meshgrid(linspace(-5, H+5, 150), linspace(-5, H+5, 150));
det_map  = zeros(size(X_grid));
sing_thr = 1e-3;
cond_thr = 100;

for ii = 1:size(X_grid,1)
    for jj = 1:size(X_grid,2)
        xP = X_grid(ii,jj);
        yP = Y_grid(ii,jj);
        Pg = [xP + m_plat*cos(210*pi/180), yP + m_plat*sin(210*pi/180);
              xP + m_plat*cos(330*pi/180), yP + m_plat*sin(330*pi/180);
              xP + m_plat*cos( 90*pi/180), yP + m_plat*sin( 90*pi/180)];
        Jg  = zeros(3,3);
        vld = true;
        for k = 1:3
            dx = Pg(k,1) - A(k,1);
            dy = Pg(k,2) - A(k,2);
            d  = sqrt(dx^2 + dy^2);
            if d > 2*l || d < 0.01
                vld = false;
                break;
            end
            arg = min(max(d/(2*l), -1), 1);
            th  = atan2(dy, dx) - acos(arg);
            Jg(k,1) = -l*sin(th);
            Jg(k,2) =  l*cos(th);
            Jg(k,3) = -l*sin(th)*(Pg(k,2)-yP) + l*cos(th)*(Pg(k,1)-xP);
        end
        if vld
            det_map(ii,jj) = abs(det(Jg));
        else
            det_map(ii,jj) = NaN;
        end
    end
end
fprintf('Ban do ky di: hoan tat\n');

%% Precompute sin/cos
% Dung q_geo (goc hinh hoc) cho sin/cos - co y nghia vat ly ro rang hon
sin_pre = sin(q_geo);
cos_pre = cos(q_geo);

%% Figure 1
ui_bg = [0.96 0.975 0.99];
ax_bg = [0.995 0.997 1.00];
fig1 = figure('Name','Robot 3-RRR | Mo Phong Gan Thuc Te', ...
    'NumberTitle','off', 'Color',ui_bg, ...
    'Units','normalized', 'OuterPosition',[0 0 1 1]);

ax_2d   = axes('Position',[0.025 0.58 0.155 0.34]);
ax_info = axes('Position',[0.025 0.08 0.155 0.42]);
ax_3d   = axes('Position',[0.205 0.36 0.335 0.56]);
ax_sin  = axes('Position',[0.205 0.08 0.155 0.23]);
ax_cos  = axes('Position',[0.385 0.08 0.155 0.23]);

pos_r = [0.585 0.57 0.185 0.32;
         0.795 0.57 0.185 0.32;
         0.585 0.12 0.185 0.32;
         0.795 0.12 0.185 0.32];
ax_r = gobjects(4,1);
for sp = 1:4
    ax_r(sp) = axes('Position', pos_r(sp,:));
end
set([ax_2d ax_info ax_3d ax_sin ax_cos ax_r'], 'Color', ax_bg);
set([ax_2d ax_3d ax_sin ax_cos ax_r'], 'LineWidth', 0.9, 'FontName', 'Arial', 'FontSize', 8);

axes(ax_2d); hold on; axis equal; grid on;
axis([-10 H+10 -10 H+10]);
xlabel('X (cm)'); ylabel('Y (cm)');
title('Det Jacobian (log10)', 'FontSize',10, 'FontWeight','bold');
contourf(ax_2d, X_grid, Y_grid, log10(det_map+1e-10), 20, 'LineColor','none');
colorbar(ax_2d); colormap(ax_2d, jet); clim(ax_2d, [-3 1]);
contour(ax_2d, X_grid, Y_grid, det_map, [sing_thr sing_thr], 'r-', 'LineWidth',2);
plot(ax_2d, [A1(1) A2(1) A3(1) A1(1)], [A1(2) A2(2) A3(2) A1(2)], 'k-', 'LineWidth',2.5);
text(ax_2d, A1(1)-3, A1(2)-3, 'A1','FontSize',9,'FontWeight','bold');
text(ax_2d, A2(1)+1, A2(2)-3, 'A2','FontSize',9,'FontWeight','bold');
text(ax_2d, A3(1),   A3(2)+2, 'A3','FontSize',9,'FontWeight','bold');
plot(ax_2d, x_traj, y_traj, 'w-', 'LineWidth',2);
plot(ax_2d, x_traj(1), y_traj(1), 'go', 'MarkerSize',9, 'MarkerFaceColor','g');
plot(ax_2d, x_traj(end), y_traj(end), 'r*', 'MarkerSize',12, 'LineWidth',2);
pt_G2d    = plot(ax_2d, nan, nan, 'wo', 'MarkerFaceColor','w','MarkerSize',7,'LineWidth',1.5);
pt_plat2d = fill(ax_2d, nan, nan, 'c', 'FaceAlpha',0.5, 'EdgeColor','w', 'LineWidth',1.5);
h_link2d  = gobjects(3,1);
for i = 1:3
    h_link2d(i) = plot(ax_2d, nan, nan, 'y-', 'LineWidth',2.5);
end

axes(ax_3d); hold on; axis equal; grid on;
xlabel('X (cm)','FontSize',11); ylabel('Y (cm)','FontSize',11); zlabel('Z (cm)','FontSize',11);
title('Mo Phong 3D Robot','FontSize',13,'FontWeight','bold');
view(45,35); lighting gouraud; camlight('right'); camlight('left');
set(ax_3d,'Color','white','GridColor',[0.75 0.75 0.75],'GridAlpha',0.5,'Box','on');
axis(ax_3d,[-10 H+10 -10 H+10 -8 8]);

[bx,by] = meshgrid(linspace(-5,H+5,2), linspace(-5,H+5,2));
surf(ax_3d, bx, by, zeros(2)-2, 'FaceColor',[0.90 0.90 0.92], 'EdgeColor','none', 'FaceAlpha',0.6);
fill3(ax_3d, [A1(1) A2(1) A3(1) A1(1)], [A1(2) A2(2) A3(2) A1(2)], zeros(1,4)-1.5, ...
    [0.75 0.75 0.78], 'FaceAlpha',0.85, 'EdgeColor',[0.2 0.2 0.2], 'LineWidth',2);

hw = w_arm/2;
ht = t_arm/2;
n_cap = 14;
jr = hw*0.7;
