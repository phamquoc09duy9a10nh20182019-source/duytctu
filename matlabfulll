%% Helper functions
function [Xc,Yc,Zc] = arm_body_surf(p1, p2, hw, ht)
vec = p2 - p1;
len = norm(vec);
if len < 1e-6
    Xc = zeros(2,5); Yc = Xc; Zc = Xc;
    return;
end
ax_l = vec / len;
ax_w = cross([0 0 1], ax_l);
if norm(ax_w) < 1e-6
    ax_w = [1 0 0];
else
    ax_w = ax_w / norm(ax_w);
end
ax_t = cross(ax_l, ax_w);
ax_t = ax_t / norm(ax_t);

cs = [ hw, ht;
       hw,-ht;
      -hw,-ht;
      -hw, ht;
       hw, ht];

Xc = zeros(2,5);
Yc = Xc;
Zc = Xc;

for ii = 1:2
    pt = ternval(ii==1, p1, p2);
    for jj = 1:5
        off = cs(jj,1)*ax_w + cs(jj,2)*ax_t;
        Xc(ii,jj) = pt(1) + off(1);
        Yc(ii,jj) = pt(2) + off(2);
        Zc(ii,jj) = pt(3) + off(3);
    end
end
end

function [Xc,Yc,Zc] = arm_cap_arc(p1, p2, side, hw, ht, n_cap)
vec = p2 - p1;
len = norm(vec);
if len < 1e-6
    Xc = zeros(n_cap,5); Yc = Xc; Zc = Xc;
    return;
end
ax_l = vec / len;
ax_w = cross([0 0 1], ax_l);
if norm(ax_w) < 1e-6
    ax_w = [1 0 0];
else
    ax_w = ax_w / norm(ax_w);
end
ax_t = cross(ax_l, ax_w);
ax_t = ax_t / norm(ax_t);

if side < 0
    ctr = p1;
    dir = -ax_l;
else
    ctr = p2;
    dir = ax_l;
end

cs = [ hw, ht;
       hw,-ht;
      -hw,-ht;
      -hw, ht;
       hw, ht];

phi_v = linspace(-pi/2, pi/2, n_cap);
Xc = zeros(n_cap,5);
Yc = Xc;
Zc = Xc;

for ii = 1:n_cap
    phi = phi_v(ii);
    pt  = ctr + dir*(hw*sin(phi));
    for jj = 1:5
        off = cs(jj,1)*cos(phi)*ax_w + cs(jj,2)*ax_t;
        Xc(ii,jj) = pt(1) + off(1);
        Yc(ii,jj) = pt(2) + off(2);
        Zc(ii,jj) = pt(3) + off(3);
    end
end
end

function r = ternval(cond, tv, fv)
if cond
    r = tv;
else
    r = fv;
end
end
